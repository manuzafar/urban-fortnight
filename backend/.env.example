# ============================================
# Inception - Backend Configuration
# ============================================
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Selection
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
LLM_MODEL=gemini-2.0-flash

# Optional: API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional: CORS Origins (comma-separated)
# For Railway deployment, add your frontend Railway URL:
# Example: https://your-frontend.up.railway.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Optional: Application Environment
# Options: development, staging, production
APP_ENV=development

# Optional: Logging
LOG_LEVEL=INFO

# Optional: Session Configuration
SESSION_EXPIRY_SECONDS=3600
MAX_CONCURRENT_SESSIONS=100

# ============================================
# Railway Deployment Notes
# ============================================
# When deploying to Railway:
# 1. Set GOOGLE_API_KEY in Railway dashboard (Variables)
# 2. Set CORS_ORIGINS to your frontend Railway URL
# 3. Set APP_ENV=production
# 4. PORT is automatically set by Railway (don't set it manually)
